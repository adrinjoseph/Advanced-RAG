# Placeholders only. Copy to .env and fill in locally. Never commit .env.
# Variable names are PROPOSED and will be confirmed when the settings class exists.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/advanced_rag
DATABASE_URL_INGEST=postgresql+asyncpg://INGEST_USER:PASSWORD@localhost:5432/advanced_rag

# --- Embeddings (provider/model NOT chosen yet) ---
EMBEDDING_PROVIDER=CHANGE_ME
EMBEDDING_MODEL=CHANGE_ME
EMBEDDING_DIM=CHANGE_ME
EMBEDDING_API_KEY=CHANGE_ME

# --- LLM (provider/model NOT chosen yet) ---
LLM_PROVIDER=CHANGE_ME
LLM_MODEL=CHANGE_ME
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT_SECONDS=30
REQUEST_DEADLINE_SECONDS=60

# --- Retrieval tuning (starting hypotheses, to be tuned by evaluation) ---
RETRIEVAL_CANDIDATES_N=50
CONTEXT_CHUNKS_M=8
RRF_K=60

# --- Optional, later phases ---
REDIS_URL=redis://localhost:6379/0
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_SECRET_KEY=CHANGE_ME

# --- Safety ---
LOG_CONTENT=false
