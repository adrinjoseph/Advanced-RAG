# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/advanced_rag

# LLM provider and model
LLM_PROVIDER=CHANGE_ME
LLM_MODEL=CHANGE_ME
LLM_API_KEY=CHANGE_ME
LLM_TIMEOUT_SECONDS=30
REQUEST_DEADLINE_SECONDS=60

# Embeddings provider and model
EMBEDDING_PROVIDER=CHANGE_ME
EMBEDDING_MODEL=CHANGE_ME
EMBEDDING_DIM=CHANGE_ME
EMBEDDING_API_KEY=CHANGE_ME

# Retrieval
RETRIEVAL_CANDIDATES_N=50
CONTEXT_CHUNKS_M=8
RRF_K=60

# Application
LOG_LEVEL=INFO
LOG_CONTENT=false